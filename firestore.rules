rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * DEVELOPMENT RULES
     * -----------------
     * Authenticated users may read/write application data.
     * NEVER use `allow read, write: if true` (public open access).
     *
     * PRODUCTION (later):
     * - Restrict by custom claims: request.auth.token.role in ['admin','cashier']
     * - Scope documents by storeId == request.auth.token.storeId
     * - Separate admin-only collections (settings, users write, etc.)
     * - Field-level validation on invoices / payments
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function callerUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn()
        && callerUser().data.role == 'admin'
        && callerUser().data.active != false;
    }

    // Application collections — authenticated only (dev)
    match /products/{id} {
      allow read, write: if isSignedIn();
      // prod: allow write: if isSignedIn() && request.auth.token.role == 'admin';
    }

    match /customers/{id} {
      allow read, write: if isSignedIn();
    }

    match /suppliers/{id} {
      allow read, write: if isSignedIn();
    }

    match /inventory/{id} {
      allow read, write: if isSignedIn();
    }

    match /invoices/{id} {
      allow read, write: if isSignedIn();
    }

    match /payments/{id} {
      allow read, write: if isSignedIn();
    }

    match /refunds/{id} {
      allow read, write: if isSignedIn();
    }

    match /notifications/{id} {
      // Clients may queue / retry; Cloud Functions update delivery status.
      allow read, write: if isSignedIn();
    }

    match /notification_logs/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /expenses/{id} {
      allow read, write: if isSignedIn();
    }

    match /settings/{id} {
      allow read, write: if isSignedIn();
      // prod: admin-only writes; never store WhatsApp access tokens here
    }

    match /sync_events/{id} {
      allow read, write: if isSignedIn();
      // prod: service account / admin only
    }

    match /users/{userId} {
      // Self-read for login profile; admins can list/create/update staff (Spark-friendly).
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
