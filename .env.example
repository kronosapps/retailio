# ---------------------------------------------------------------------------
# Store defaults
# ---------------------------------------------------------------------------

VITE_STORE_ID=store-1

# ---------------------------------------------------------------------------
# Local-auth fallback (only when Firebase env is incomplete)
# Login uses username + passcode for everyone.
# ---------------------------------------------------------------------------

VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSCODE=admin123
VITE_ADMIN_NAME=Store Admin

VITE_CASHIER_USERNAME=cashier
VITE_CASHIER_PASSCODE=cash123
VITE_CASHIER_NAME=Sales Cashier

VITE_MANAGER_USERNAME=manager
VITE_MANAGER_PASSCODE=mgr123
VITE_MANAGER_NAME=Store Manager

# ---------------------------------------------------------------------------
# Firebase (when set, login uses Firebase Auth + Firestore users/{uid})
# Auth email under the hood = {username}@retailos.local
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Google Apps Script → Sheets sync (NOT a database — reporting/backup only)
# ---------------------------------------------------------------------------

VITE_GOOGLE_SCRIPT_URL=

# ---------------------------------------------------------------------------
# Company WhatsApp receipts (webhook → Business Cloud API / BSP)
# Never put Meta access tokens here — only the server webhook URL.
# See docs/WHATSAPP_RECEIPTS.md
# ---------------------------------------------------------------------------

VITE_WHATSAPP_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Banking & GST (admin Banking module — values from env, not hard-coded UI)
# Unlock / edit passcode (falls back to VITE_ADMIN_PASSCODE if unset)
# ---------------------------------------------------------------------------

VITE_BANKING_PASSCODE=admin123
VITE_BANKING_OPENING_CASH_RUPEES=5000
VITE_BANKING_OPENING_UPI_RUPEES=10000

VITE_BANK_NAME=HDFC Bank
VITE_BANK_ACCOUNT_NAME=RetailOS Store Current A/C
VITE_BANK_ACCOUNT_NUMBER=50200012345678
VITE_BANK_IFSC=HDFC0001234
VITE_BANK_BRANCH=Main Road Branch
VITE_BANK_UPI_ID=store@hdfcbank

VITE_GSTIN=36AAAAA0000A1Z5
VITE_GST_LEGAL_NAME=RetailOS Traders Pvt Ltd
VITE_GST_TRADE_NAME=RetailOS Store
VITE_GST_ADDRESS=Shop 12, Market Road, Hyderabad, Telangana 500001
